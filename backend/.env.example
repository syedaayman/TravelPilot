# TravelPilot Backend Environment Configuration
# Copy this file to .env and provide your credentials

# Groq API Key (for TravelPilot Assistant)
GROQ_API_KEY=
# Select `groq` only when Groq should serve chat; Gemini remains the default.
AI_PROVIDER=gemini

# Supabase PostgreSQL Configuration
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=

# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
